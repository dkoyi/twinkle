{
  "framework": null,
  "installCommand": "",
  "buildCommand": "python3 scripts/build_static.py --working",
  "outputDirectory": "deploy/techtwin",
  "rewrites": [
    { "source": "/", "destination": "/voice-demo/index.html" },
    { "source": "/talk", "destination": "/voice-demo/index.html" }
  ],
  "redirects": [
    { "source": "/dashboard", "destination": "/static/dashboard.html?demo=dal", "permanent": false },
    { "source": "/family", "destination": "/static/dashboard.html?demo=dal", "permanent": false }
  ]
}
