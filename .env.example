# Copy this file to .env and fill in your own values. Never commit .env.

# Twilio (twilio.com/console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Public URL from ngrok, e.g. https://abc123.ngrok-free.app (no trailing slash)
PUBLIC_BASE_URL=

# Gemini API key (aistudio.google.com)
GEMINI_API_KEY=

# Optional fallback for the browser agent (console.anthropic.com)
ANTHROPIC_API_KEY=

# Model names (verify on the Gemini docs before coding; names change)
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
COMPUTER_USE_MODEL=gemini-2.5-computer-use-preview-10-2025

# Later, only after the Gemini path works end to end (Supermemory prize)
SUPERMEMORY_API_KEY=

# Dev only: lets POST /api/dev/replay play a fake call onto the dashboard
DEV_REPLAY=true

# Browser agent
# Extra words that need a spoken yes before clicking (so TechTwin asks "Shall I press play?")
ASK_FIRST_EXTRA=play
# Page the browser returns to on reset when DEMO_MODE=true
START_URL=http://localhost:8000/static/start.html
# Auto-allow a fake camera and mic so meeting pages don't stall on a permission popup
FAKE_MEDIA=true
# Model used by describe_screen (plain words about the screen)
DESCRIBE_MODEL=gemini-2.5-flash
# Seconds to wait for a spoken yes before treating it as a no
APPROVAL_TIMEOUT_S=60
# Write logs/<date>/<id>.jsonl for the pitch numbers (python scripts/stats.py)
LOG_EVENTS=true
# Set false to run the server without opening the browser (UI-only work)
BROWSER_AUTOSTART=true

# Which computer-use model to use: gemini or claude
COMPUTER_USE_PROVIDER=gemini

# Sites the agent may visit (comma-separated)
ALLOWED_DOMAINS=youtube.com,google.com,zoom.us,meet.google.com,cvs.com,apple.com

# Demo mode: opens a clean start page and limits task length
DEMO_MODE=true
MAX_TASK_SECONDS=120
MAX_TASK_STEPS=25
